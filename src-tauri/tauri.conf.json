{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flash Launcher",
  "version": "0.8.0",
  "identifier": "com.flashlauncher.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flash Launcher",
        "width": 1366,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/**"
          ],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "caidn",
    "copyright": "© 2026 caidn. Ruffle is © the Ruffle contributors (MIT / Apache-2.0).",
    "category": "Game",
    "shortDescription": "A Metro-style launcher for Flash games",
    "longDescription": "Flash Launcher keeps your Flash games in one library with real art, plays them through Ruffle, and can download games from Flashpoint Archive.",
    "homepage": "https://github.com/caidn/FlashLauncher",
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Flash Launcher"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCOTgzOUU2NTREMUY4Q0EKUldUSytORlU1am1ZRzB5bkpwcVliMWlmaHROL2hCNkZnVENEUDQvelhHakhKaHZ2b1NtcXhvMDMK",
      "endpoints": [
        "https://github.com/caidn/FlashLauncher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
